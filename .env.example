# Copie para .env.local.
#
# Desenvolvimento local (Supabase via Docker, após `npm run db:start`):
#   Os valores aparecem na saída de `npm run db:status` (API URL e anon key).
#   Padrão do Supabase local:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-key-do-db:status

# Produção: troque pela URL e pela chave anon do projeto na nuvem.
# Nunca coloque a service_role aqui.
